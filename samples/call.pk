native val println: { String => none };

function greet(name) {
    return "Hello " + name + "!"
}

const greet = function (name) {
    return "Hello " + name + "!"
}
println(greet("Pocket"))

val greet = { name => "Hello " + name + "!" };
"Pocket" -> greet -> println;

async scenarios => callback/async/await

